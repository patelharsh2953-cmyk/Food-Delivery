# ==========================================
# FOOD-DEL Project - Root .gitignore
# ==========================================

# ── Dependencies ──
node_modules/
*/node_modules/
.pnp
.pnp.js

# ── Environment & Secrets ──
.env
.env.*
!.env.example
backend/.env
admin/.env
frontend/.env

# ── Production Builds ──
dist/
dist-ssr/
build/
out/
*/dist/
*/build/

# ── Logs & Debug Files ──
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor & IDE Configurations ──
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── Operating System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Temporary & Cache Files ──
.tmp/
tmp/
.cache/
.eslintcache
.stylelintcache
*.local
